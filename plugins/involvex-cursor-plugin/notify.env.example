# Copy to ~/.config/involvex/notify.env (never commit real values).
# Hook loads this automatically when Cursor env vars are unset.

INVOLVEX_NOTIFY=auto

# Google Chat via gws (preferred when configured)
INVOLVEX_GWS_CHAT_SPACE=spaces/AAQAiK8Oa3Q

# Optional Telegram fallback
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# After `gh pr create`, detach OpenCode on the always-on service to babysit CI
INVOLVEX_PR_BABYSIT=auto
# INVOLVEX_OPENCODE_SERVER=http://127.0.0.1:4000
# INVOLVEX_OPENCODE_MODEL=kilo/kilo-auto/free

