{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/format-after-edit.mjs\""
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/gate-shell.mjs\"",
        "matcher": "rm\\b|del\\b|Remove-Item|curl\\b|wget\\b|Invoke-WebRequest|force-with-lease|force\\b|--force|git\\s+reset\\s+--hard|git\\s+clean\\s+-f"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/block-secrets.mjs\""
      }
    ]
  }
}
